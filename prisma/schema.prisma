generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// IDENTITY / ACCESS
// =========================================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles              UserRole[]
  orgAccess          UserOrganizationAccess[]
  departmentAccess   UserDepartmentAccess[]
  projectAccess      UserProjectAccess[]
  auditLogs          AuditLog[]
  responsibleFor     AccrualDocument[]        @relation("AccrualResponsible")
  paymentRequests    PaymentRequest[]         @relation("PaymentRequestCreatedBy")
  approvals          PaymentRequestApproval[]
  closedPeriods      AccountingPeriod[]       @relation("PeriodClosedBy")
  reopenedPeriods    AccountingPeriod[]       @relation("PeriodReopenedBy")
  employee           Employee?
  importBatches      BankImportBatch[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  code        String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserOrganizationAccess {
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@map("user_organization_access")
}

model UserDepartmentAccess {
  userId       String
  departmentId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@map("user_department_access")
}

model UserProjectAccess {
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("user_project_access")
}

// =========================================================================
// MASTER DATA
// =========================================================================

enum OrganizationType {
  LEGAL_ENTITY
  SOLE_PROPRIETOR
}

model Organization {
  id            String           @id @default(cuid())
  name          String
  shortName     String?
  type          OrganizationType
  inn           String?
  kpp           String?
  ogrn          String?
  legalAddress  String?
  isArchived    Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  departments       Department[]
  projects          Project[]
  bankAccounts      BankAccount[]
  cashAccounts      CashAccount[]
  contracts         Contract[]
  accrualDocuments  AccrualDocument[]
  employees         Employee[]
  userAccess        UserOrganizationAccess[]
  payrollRuns       PayrollRun[]
  paymentRequests   PaymentRequest[]

  @@map("organizations")
}

model Department {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  parentId       String?
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization?         @relation(fields: [organizationId], references: [id])
  parent          Department?           @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children        Department[]          @relation("DepartmentHierarchy")
  costCenters     DepartmentCostCenter[]
  userAccess      UserDepartmentAccess[]
  employees       Employee[]
  accrualLines    AccrualDocumentLine[]
  bankTx          BankTransaction[]
  payrollLines    PayrollLine[]
  payrollAlloc    PayrollAllocation[]
  historyFrom     EmploymentHistory[] @relation("EmploymentHistoryFromDepartment")
  historyTo       EmploymentHistory[] @relation("EmploymentHistoryToDepartment")

  @@map("departments")
}

model CostCenter {
  id         String   @id @default(cuid())
  name       String
  code       String?
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  departments  DepartmentCostCenter[]
  accrualLines AccrualDocumentLine[]
  bankTx       BankTransaction[]

  @@map("cost_centers")
}

model DepartmentCostCenter {
  departmentId String
  costCenterId String
  validFrom    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  costCenter CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Cascade)

  @@id([departmentId, costCenterId])
  @@map("department_cost_centers")
}

model Project {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String?
  status         String    @default("active")
  startDate      DateTime?
  endDate        DateTime?
  isArchived     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id])
  userAccess    UserProjectAccess[]
  accrualLines  AccrualDocumentLine[]
  bankTx        BankTransaction[]
  payrollLines  PayrollLine[]
  payrollAlloc  PayrollAllocation[]
  employeeProj  EmployeeProjectAllocation[]
  timeSheets    TimeSheet[]

  @@map("projects")
}

model Direction {
  id         String   @id @default(cuid())
  name       String
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  productsServices ProductService[]

  @@map("directions")
}

model ProductService {
  id          String   @id @default(cuid())
  directionId String?
  name        String
  code        String?
  unit        String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  direction    Direction?            @relation(fields: [directionId], references: [id])
  accrualLines AccrualDocumentLine[]
  bankTx       BankTransaction[]

  @@map("products_services")
}

model Counterparty {
  id             String   @id @default(cuid())
  fullName       String
  shortName      String?
  inn            String?
  kpp            String?
  ogrn           String?
  legalAddress   String?
  actualAddress  String?
  director       String?
  status         String?
  isIntermediary Boolean  @default(false)
  dataSource     String?
  dataUpdatedAt  DateTime?
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bankDetails      CounterpartyBankDetail[]
  contacts         CounterpartyContact[]
  contracts        Contract[]
  accrualDocuments AccrualDocument[]
  bankTx           BankTransaction[]
  paymentRequests  PaymentRequest[]

  @@map("counterparties")
}

model CounterpartyBankDetail {
  id             String @id @default(cuid())
  counterpartyId String
  bankName       String
  account        String
  bik            String?
  corrAccount    String?

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@map("counterparty_bank_details")
}

model CounterpartyContact {
  id             String  @id @default(cuid())
  counterpartyId String
  name           String
  phone          String?
  email          String?
  position       String?

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@map("counterparty_contacts")
}

model Contract {
  id             String    @id @default(cuid())
  organizationId String
  counterpartyId String
  number         String
  date           DateTime
  subject        String?
  amount         Decimal?  @db.Decimal(18, 2)
  status         String    @default("active")
  isArchived     Boolean   @default(false)
  createdAt      DateTime  @default(now())

  organization  Organization      @relation(fields: [organizationId], references: [id])
  counterparty  Counterparty      @relation(fields: [counterpartyId], references: [id])
  accrualDocs   AccrualDocument[]

  @@map("contracts")
}

enum CashFlowDirection {
  INFLOW
  OUTFLOW
  TRANSFER
}

model CashFlowArticle {
  id         String            @id @default(cuid())
  name       String
  code       String?
  direction  CashFlowDirection
  parentId   String?
  isArchived Boolean           @default(false)

  parent       CashFlowArticle?  @relation("CashFlowArticleHierarchy", fields: [parentId], references: [id])
  children     CashFlowArticle[] @relation("CashFlowArticleHierarchy")
  bankTx       BankTransaction[]
  paymentReqs  PaymentRequest[]

  @@map("cash_flow_articles")
}

enum PnlArticleType {
  REVENUE
  DIRECT_VARIABLE
  DIRECT_FIXED
  INDIRECT
  OTHER_INCOME
  OTHER_EXPENSE
  TAX
}

model PnlArticle {
  id         String         @id @default(cuid())
  name       String
  code       String?
  type       PnlArticleType
  parentId   String?
  isArchived Boolean        @default(false)

  parent       PnlArticle?           @relation("PnlArticleHierarchy", fields: [parentId], references: [id])
  children     PnlArticle[]          @relation("PnlArticleHierarchy")
  accrualLines AccrualDocumentLine[]
  payrollTypes PayrollAccrualType[]

  @@map("pnl_articles")
}

enum BalanceArticleCategory {
  ASSET
  LIABILITY
  EQUITY
}

model BalanceArticle {
  id         String                  @id @default(cuid())
  name       String
  code       String?
  category   BalanceArticleCategory
  isArchived Boolean                 @default(false)

  @@map("balance_articles")
}

// =========================================================================
// BANK / CASH ACCOUNTS
// =========================================================================

model BankAccount {
  id             String   @id @default(cuid())
  organizationId String
  bankName       String
  accountNumber  String
  bik            String?
  currency       String   @default("RUB")
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id])
  importBatches BankImportBatch[]
  transactions BankTransaction[]

  @@map("bank_accounts")
}

model CashAccount {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  currency       String   @default("RUB")
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id])
  transactions BankTransaction[]

  @@map("cash_accounts")
}

// =========================================================================
// ACCRUALS / PRIMARY DOCUMENTS
// =========================================================================

enum AccrualDocumentType {
  INVOICE
  ACT
  UPD
  WAYBILL
  SALE
  RECEIPT
  RETURN
  CORRECTION
  MANUAL
}

enum AccrualDirection {
  INCOME
  EXPENSE
}

enum AccrualDocumentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERPAID
}

model AccrualDocument {
  id              String                 @id @default(cuid())
  organizationId  String
  counterpartyId  String
  contractId      String?
  number          String
  date            DateTime
  documentType    AccrualDocumentType
  direction       AccrualDirection
  status          AccrualDocumentStatus  @default(DRAFT)
  paymentStatus   PaymentStatus          @default(UNPAID)
  dueDate         DateTime?
  responsibleId   String?
  sourceSystem    String?                // e.g. "1C", "manual"
  externalId      String?
  comment         String?
  periodId        String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  version         Int                    @default(1)

  organization Organization       @relation(fields: [organizationId], references: [id])
  counterparty Counterparty       @relation(fields: [counterpartyId], references: [id])
  contract     Contract?          @relation(fields: [contractId], references: [id])
  responsible  User?              @relation("AccrualResponsible", fields: [responsibleId], references: [id])
  period       AccountingPeriod?  @relation(fields: [periodId], references: [id])
  lines        AccrualDocumentLine[]
  allocations  PaymentAllocation[]
  externalLink IntegrationExternalObject[]
  auditLogs    AuditLog[]

  @@unique([sourceSystem, externalId])
  @@index([organizationId, date])
  @@index([counterpartyId])
  @@map("accrual_documents")
}

model AccrualDocumentLine {
  id               String   @id @default(cuid())
  documentId       String
  departmentId     String?
  costCenterId     String?
  projectId        String?
  productServiceId String?
  pnlArticleId     String?
  amount           Decimal  @db.Decimal(18, 2)
  vatAmount        Decimal? @db.Decimal(18, 2)
  description      String?

  document       AccrualDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  department     Department?     @relation(fields: [departmentId], references: [id])
  costCenter     CostCenter?     @relation(fields: [costCenterId], references: [id])
  project        Project?        @relation(fields: [projectId], references: [id])
  productService ProductService? @relation(fields: [productServiceId], references: [id])
  pnlArticle     PnlArticle?     @relation(fields: [pnlArticleId], references: [id])

  @@map("accrual_document_lines")
}

// =========================================================================
// BANK TRANSACTIONS / MATCHING
// =========================================================================

model BankImportBatch {
  id            String   @id @default(cuid())
  bankAccountId String
  fileName      String
  format        String
  importedById  String?
  totalRows     Int      @default(0)
  importedRows  Int      @default(0)
  duplicateRows Int      @default(0)
  errorRows     Int      @default(0)
  createdAt     DateTime @default(now())

  bankAccount  BankAccount       @relation(fields: [bankAccountId], references: [id])
  importedBy   User?             @relation(fields: [importedById], references: [id])
  transactions BankTransaction[]

  @@map("bank_import_batches")
}

enum BankTransactionDirection {
  INFLOW
  OUTFLOW
}

enum BankTransactionMatchStatus {
  UNMATCHED
  PARTIALLY_MATCHED
  MATCHED
}

model BankTransaction {
  id               String                      @id @default(cuid())
  bankAccountId    String?
  cashAccountId    String?
  batchId          String?
  operationDate    DateTime
  direction        BankTransactionDirection
  amount           Decimal                     @db.Decimal(18, 2)
  purpose          String?
  counterpartyId   String?
  counterpartyInn  String?
  cashFlowArticleId String?
  departmentId     String?
  costCenterId     String?
  projectId        String?
  productServiceId String?
  matchStatus      BankTransactionMatchStatus  @default(UNMATCHED)
  fingerprint      String                      @unique
  isTransfer       Boolean                     @default(false)
  createdAt        DateTime                    @default(now())

  bankAccount     BankAccount?      @relation(fields: [bankAccountId], references: [id])
  cashAccount     CashAccount?      @relation(fields: [cashAccountId], references: [id])
  batch           BankImportBatch?  @relation(fields: [batchId], references: [id])
  counterparty    Counterparty?     @relation(fields: [counterpartyId], references: [id])
  cashFlowArticle CashFlowArticle?  @relation(fields: [cashFlowArticleId], references: [id])
  department      Department?       @relation(fields: [departmentId], references: [id])
  costCenter      CostCenter?       @relation(fields: [costCenterId], references: [id])
  project         Project?          @relation(fields: [projectId], references: [id])
  productService  ProductService?   @relation(fields: [productServiceId], references: [id])
  allocations     PaymentAllocation[]

  @@index([operationDate])
  @@map("bank_transactions")
}

model PaymentAllocation {
  id                String   @id @default(cuid())
  bankTransactionId String
  accrualDocumentId String
  amount            Decimal  @db.Decimal(18, 2)
  createdAt         DateTime @default(now())
  cancelledAt       DateTime?

  bankTransaction BankTransaction @relation(fields: [bankTransactionId], references: [id])
  accrualDocument AccrualDocument @relation(fields: [accrualDocumentId], references: [id])

  @@map("payment_allocations")
}

// =========================================================================
// PAYMENT REQUESTS / CALENDAR
// =========================================================================

enum PaymentRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

model PaymentRequest {
  id                String                @id @default(cuid())
  organizationId    String
  counterpartyId    String?
  cashFlowArticleId String?
  amount            Decimal               @db.Decimal(18, 2)
  dueDate           DateTime
  status            PaymentRequestStatus  @default(DRAFT)
  comment           String?
  createdById       String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  createdBy       User                       @relation("PaymentRequestCreatedBy", fields: [createdById], references: [id])
  cashFlowArticle CashFlowArticle?           @relation(fields: [cashFlowArticleId], references: [id])
  organization    Organization               @relation(fields: [organizationId], references: [id])
  counterparty    Counterparty?              @relation(fields: [counterpartyId], references: [id])
  approvals       PaymentRequestApproval[]

  @@map("payment_requests")
}

model PaymentRequestApproval {
  id               String   @id @default(cuid())
  paymentRequestId String
  approverId       String
  decision         String   // approved / rejected
  comment          String?
  decidedAt        DateTime @default(now())

  paymentRequest PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  approver       User           @relation(fields: [approverId], references: [id])

  @@map("payment_request_approvals")
}

// =========================================================================
// EMPLOYEES / PAYROLL
// =========================================================================

model Position {
  id         String  @id @default(cuid())
  name       String
  isArchived Boolean @default(false)

  employees   Employee[]
  historyFrom EmploymentHistory[] @relation("EmploymentHistoryFromPosition")
  historyTo   EmploymentHistory[] @relation("EmploymentHistoryToPosition")

  @@map("positions")
}

model WorkSchedule {
  id         String  @id @default(cuid())
  name       String
  isArchived Boolean @default(false)

  employees Employee[]

  @@map("work_schedules")
}

enum PaymentMethod {
  CASH
  BANK
  MIXED
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

model Employee {
  id              String         @id @default(cuid())
  userId          String?        @unique
  fullName        String
  personnelNumber String?
  organizationId  String
  departmentId    String?
  positionId      String?
  workScheduleId  String?
  hireDate        DateTime
  terminationDate DateTime?
  status          EmployeeStatus @default(ACTIVE)
  paymentMethod   PaymentMethod  @default(BANK)
  bankAccount     String?
  salary          Decimal?       @db.Decimal(18, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user           User?                       @relation(fields: [userId], references: [id])
  organization   Organization                @relation(fields: [organizationId], references: [id])
  department     Department?                 @relation(fields: [departmentId], references: [id])
  position       Position?                   @relation(fields: [positionId], references: [id])
  workSchedule   WorkSchedule?               @relation(fields: [workScheduleId], references: [id])
  employmentHist EmploymentHistory[]
  timeSheets     TimeSheet[]
  payrollLines   PayrollLine[]
  projectAlloc   EmployeeProjectAllocation[]

  @@map("employees")
}

model EmploymentHistory {
  id         String   @id @default(cuid())
  employeeId String
  eventType  String   // hire / transfer / termination
  eventDate  DateTime
  fromDepartmentId String?
  toDepartmentId   String?
  fromPositionId   String?
  toPositionId     String?
  comment    String?
  createdAt  DateTime @default(now())

  employee      Employee    @relation(fields: [employeeId], references: [id])
  fromDepartment Department? @relation("EmploymentHistoryFromDepartment", fields: [fromDepartmentId], references: [id])
  toDepartment   Department? @relation("EmploymentHistoryToDepartment", fields: [toDepartmentId], references: [id])
  fromPosition   Position?   @relation("EmploymentHistoryFromPosition", fields: [fromPositionId], references: [id])
  toPosition     Position?   @relation("EmploymentHistoryToPosition", fields: [toPositionId], references: [id])

  @@map("employment_history")
}

model EmployeeProjectAllocation {
  id         String   @id @default(cuid())
  employeeId String
  projectId  String
  sharePct   Decimal  @db.Decimal(5, 2)
  validFrom  DateTime @default(now())
  validTo    DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])
  project  Project  @relation(fields: [projectId], references: [id])

  @@map("employee_project_allocations")
}

model TimeSheet {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime
  hours      Decimal  @db.Decimal(5, 2)
  dayType    String   // work / weekend / vacation / sick_leave / business_trip / absence / overtime / project
  projectId  String?
  comment    String?
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
  project  Project? @relation(fields: [projectId], references: [id])

  @@unique([employeeId, date, dayType, projectId])
  @@map("time_sheets")
}

model PayrollAccrualType {
  id                  String   @id @default(cuid())
  name                String
  code                String   @unique
  subjectToNdfl       Boolean  @default(true)
  subjectToInsurance  Boolean  @default(true)
  affectsAvgEarnings  Boolean  @default(true)
  paymentMethod       PaymentMethod @default(BANK)
  pnlArticleId        String?
  isArchived          Boolean  @default(false)

  pnlArticle   PnlArticle?    @relation(fields: [pnlArticleId], references: [id])
  payrollLines PayrollLine[]

  @@map("payroll_accrual_types")
}

enum PayrollRunKind {
  ADVANCE
  FINAL
  ADHOC
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
}

model PayrollRun {
  id             String           @id @default(cuid())
  organizationId String
  periodId       String
  kind           PayrollRunKind
  payoutDate     DateTime
  status         PayrollRunStatus @default(DRAFT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  period       AccountingPeriod @relation(fields: [periodId], references: [id])
  lines        PayrollLine[]

  @@map("payroll_runs")
}

model PayrollLine {
  id            String  @id @default(cuid())
  payrollRunId  String
  employeeId    String
  accrualTypeId String
  departmentId  String?
  projectId     String?
  amount        Decimal @db.Decimal(18, 2)
  ndflAmount    Decimal @default(0) @db.Decimal(18, 2)
  insuranceAmount Decimal @default(0) @db.Decimal(18, 2)

  payrollRun  PayrollRun          @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee    Employee            @relation(fields: [employeeId], references: [id])
  accrualType PayrollAccrualType  @relation(fields: [accrualTypeId], references: [id])
  department  Department?         @relation(fields: [departmentId], references: [id])
  project     Project?            @relation(fields: [projectId], references: [id])
  allocations PayrollAllocation[]

  @@map("payroll_lines")
}

model PayrollAllocation {
  id            String  @id @default(cuid())
  payrollLineId String
  departmentId  String?
  projectId     String?
  sharePct      Decimal @db.Decimal(5, 2)
  amount        Decimal @db.Decimal(18, 2)

  payrollLine PayrollLine @relation(fields: [payrollLineId], references: [id], onDelete: Cascade)
  department  Department? @relation(fields: [departmentId], references: [id])
  project     Project?    @relation(fields: [projectId], references: [id])

  @@map("payroll_allocations")
}

model TaxRule {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  ratePct     Decimal @db.Decimal(5, 2)
  base        String  // ndfl / pension / medical / social / injury
  isArchived  Boolean @default(false)

  @@map("tax_rules")
}

// =========================================================================
// PERIOD CLOSE
// =========================================================================

enum PeriodStatus {
  OPEN
  CLOSED
}

model AccountingPeriod {
  id           String       @id @default(cuid())
  year         Int
  month        Int
  status       PeriodStatus @default(OPEN)
  closedById   String?
  closedAt     DateTime?
  reopenedById String?
  reopenedAt   DateTime?
  createdAt    DateTime     @default(now())

  closedBy      User?               @relation("PeriodClosedBy", fields: [closedById], references: [id])
  reopenedBy    User?               @relation("PeriodReopenedBy", fields: [reopenedById], references: [id])
  checks        PeriodCloseCheck[]
  accrualDocs   AccrualDocument[]
  payrollRuns   PayrollRun[]

  @@unique([year, month])
  @@map("accounting_periods")
}

model PeriodCloseCheck {
  id         String   @id @default(cuid())
  periodId   String
  checkType  String
  severity   String   // critical / warning
  passed     Boolean
  message    String?
  checkedAt  DateTime @default(now())

  period AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@map("period_close_checks")
}

// =========================================================================
// INTEGRATIONS
// =========================================================================

model IntegrationProfile {
  id          String   @id @default(cuid())
  system      String   // "1C" / "BITRIX24" / "BANK"
  name        String
  isEnabled   Boolean  @default(false)
  config      Json?
  createdAt   DateTime @default(now())

  batches IntegrationBatch[]

  @@map("integration_profiles")
}

model IntegrationBatch {
  id                  String   @id @default(cuid())
  integrationProfileId String
  fileName            String?
  status              String   // running / completed / failed
  importedCount       Int      @default(0)
  updatedCount        Int      @default(0)
  skippedCount        Int      @default(0)
  errorCount          Int      @default(0)
  startedAt           DateTime @default(now())
  finishedAt          DateTime?
  errorLog            Json?

  profile        IntegrationProfile          @relation(fields: [integrationProfileId], references: [id])
  externalObjects IntegrationExternalObject[]

  @@map("integration_batches")
}

model IntegrationExternalObject {
  id                String   @id @default(cuid())
  batchId           String?
  sourceSystem      String
  sourceEntityType  String
  externalId        String
  localEntityType   String
  localEntityId     String
  accrualDocumentId String?
  status            String   @default("synced") // synced / conflict / error
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  batch           IntegrationBatch? @relation(fields: [batchId], references: [id])
  accrualDocument AccrualDocument?  @relation(fields: [accrualDocumentId], references: [id])

  @@unique([sourceSystem, sourceEntityType, externalId])
  @@map("integration_external_objects")
}

model IntegrationOutbox {
  id           String    @id @default(cuid())
  eventType    String
  targetSystem String    // "BITRIX24"
  payload      Json
  idempotencyKey String  @unique
  status       String    @default("pending") // pending / sent / failed
  attempts     Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())
  sentAt       DateTime?

  @@map("integration_outbox")
}

// =========================================================================
// FINANCIAL MODELING
// =========================================================================

model FinancialScenario {
  id          String   @id @default(cuid())
  name        String
  type        String   // base / optimistic / pessimistic / custom
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  values FinancialScenarioValue[]

  @@map("financial_scenarios")
}

model FinancialScenarioValue {
  id         String   @id @default(cuid())
  scenarioId String
  year       Int
  month      Int
  driver     String
  dimension  String?
  value      Decimal  @db.Decimal(18, 4)

  scenario FinancialScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, year, month, driver, dimension])
  @@map("financial_scenario_values")
}

// =========================================================================
// AUDIT
// =========================================================================

model AuditLog {
  id                String   @id @default(cuid())
  userId            String?
  entityType        String
  entityId          String
  action            String   // create / update / archive / restore / close_period / reopen_period
  beforeJson         Json?
  afterJson          Json?
  accrualDocumentId String?
  createdAt         DateTime @default(now())

  user            User?            @relation(fields: [userId], references: [id])
  accrualDocument AccrualDocument? @relation(fields: [accrualDocumentId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_log")
}
