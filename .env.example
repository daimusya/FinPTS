DATABASE_URL="postgresql://postgres:postgres@localhost:5432/promtehnosfera?schema=public"
AUTH_SECRET="replace-with-a-long-random-string"

# Email of the first administrator created by npm run db:seed (defaults to admin@example.com)
SEED_ADMIN_EMAIL="admin@your-company.ru"

# Backups (npm run db:backup). All optional.
# BACKUP_DIR="backups"          # main folder, next to the database
# BACKUP_KEEP="14"              # how many copies to keep there
# Second copy in another place: another disk, a network share or a cloud-synced folder (OneDrive, Yandex Disk).
# BACKUP_MIRROR_DIR="D:\backups-promtehnosfera"
# BACKUP_MIRROR_KEEP="30"
# With a password the second copy is encrypted (AES-256-GCM, .dump.enc); keep the password outside this server.
# BACKUP_MIRROR_PASSWORD="at least 12 characters"
